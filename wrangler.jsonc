// Cloudflare Workers deploy config: the Worker handles /api/*, the static Vite build is served from dist/.
// `npx wrangler deploy` deploys the main site; `npx wrangler deploy --env test` the test site.
{
  "name": "astro-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Better Auth hashes passwords with node:crypto scrypt.
  "compatibility_flags": ["nodejs_compat"],
  // Main site address; Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "duoastro.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths fall back to index.html (single-page app)...
    "not_found_handling": "single-page-application",
    // ...except the API, which must reach the Worker.
    "run_worker_first": ["/api/*"]
  },
  // Daily cleanup of expired sessions and old feedback (scheduled() in worker/index.js), 03:00 UTC.
  "triggers": { "crons": ["0 3 * * *"] },
  // Per-IP limits against request floods (see rateLimited in worker/index.js).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // Feedback notifications by email (see notifyFeedback in worker/index.js); the recipient is the
  // FEEDBACK_TO secret, so the address stays out of the repository. Main site only.
  "send_email": [{ "name": "FEEDBACK_EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astro-app",
      "database_id": "d1184168-5a72-40be-b58c-870dad9e929b"
    }
  ],
  "env": {
    // Test site with its own database: astro-app-auth-test.<account>.workers.dev.
    // Bindings are not inherited by environments, so they are repeated here.
    "test": {
      "name": "astro-app-auth-test",
      // routes are inherited, so the test site must opt out of duoastro.app.
      "routes": [],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "astro-app-test",
          "database_id": "76d97685-14e0-468a-818d-df687949482c"
        }
      ]
    }
  }
}
