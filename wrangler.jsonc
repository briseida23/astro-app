// Cloudflare Workers deploy config: serves the static Vite build from dist/.
{
  "name": "astro-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths fall back to index.html (single-page app).
    "not_found_handling": "single-page-application"
  }
}
