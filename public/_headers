# Headers for static files (Cloudflare Workers static assets read this file; /api answers come
# from the Worker). When several rules match a path, their headers are combined.

# Security headers for every page: no framing by other sites (clickjacking), HTTPS only,
# no MIME sniffing, no full URLs in Referer, and only the browser features the app uses.
/*
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()

# Browser caching. HTML is left as is (revalidated on every visit) so a deploy shows up at once.

# Vite build output: the file name changes with the content, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Swiss Ephemeris data files: fixed names, but they change only with a new Swiss Ephemeris release.
/ephe/*
  Cache-Control: public, max-age=2592000

# Icons keep their names, so a week keeps a new icon from waiting too long.
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
